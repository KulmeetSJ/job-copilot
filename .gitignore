# ==============================================================================
# Job Copilot .gitignore
# ==============================================================================

# Python bytecode & environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Secrets & Environment variables
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# Local Databases
*.sqlite
*.sqlite3
*.db
data/*.sqlite
data/*.db
data/job_copilot.db

# Testing, Coverage & Linters
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# OS & IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*/.DS_Store
Thumbs.db

# Browser Automation Artifacts & Playwright
.playwright/
playwright-report/
test-results/
data/downloads/
data/test_screenshots/

# Sensitive Candidate Truth & Dynamic Runtime Stores
data/candidate/
data/jobs/
data/applications/
data/tracking/
data/copilot/
data/generated/
data/resumes/
data/extracted_raw_resumes.json

# Explicitly track safe repository configurations and strategies
!data/config/
!data/config/*.yaml
!data/resume_strategies/
!data/resume_strategies/*.yaml
!data/sample_jds/
!data/sample_jds/*
