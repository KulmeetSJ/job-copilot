# ==============================================================================
# Job Copilot - Environment Configuration
# ==============================================================================

# Application & Environment
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database
# Default: SQLite file inside data/ directory
DATABASE_URL=sqlite:///./data/job_copilot.db

# Master Profile File Location
CANDIDATE_PROFILE_PATH=./data/candidate/master_profile.yaml

# MCP Server Settings
MCP_SERVER_NAME=job-copilot

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000

# Future LLM Configuration (Not required for initial phase)
LLM_PROVIDER=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
