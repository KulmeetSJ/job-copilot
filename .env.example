# ==============================================================================
# Job Copilot - Environment Configuration Template
# NOTE: Copy this file to .env and configure for local runtime. Do NOT commit .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Runtime Settings
# ------------------------------------------------------------------------------
APP_ENV=development                  # development, staging, production
DEBUG=false
LOG_LEVEL=INFO                       # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=text                      # text, json

# ------------------------------------------------------------------------------
# 2. API Server & Dashboard Security
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_API_KEY=                    # REQUIRED in production. Secret key for dashboard and API access
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173  # Comma-separated allowed web origins
SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# ------------------------------------------------------------------------------
# 3. Database & Storage Configuration
# ------------------------------------------------------------------------------
# Local Development Default: SQLite file inside data/ directory
DATABASE_URL=sqlite:///./data/job_copilot.db
# Local Docker PostgreSQL: postgresql+psycopg://copilot_user:copilot_password@localhost:5432/job_copilot
# Cloud Managed PostgreSQL: postgresql+psycopg://<user>:<password>@<host>:5432/<database>?sslmode=require

# ------------------------------------------------------------------------------
# 4. Candidate Profile & Data Locations
# ------------------------------------------------------------------------------
CANDIDATE_PROFILE_PATH=./data/candidate/master_profile.yaml
CANDIDATE_EVIDENCE_PATH=./data/candidate/evidence.yaml
CANDIDATE_PREFERENCES_PATH=./data/candidate/preferences.yaml

# ------------------------------------------------------------------------------
# 5. Browser Automation & Playwright Settings
# ------------------------------------------------------------------------------
PLAYWRIGHT_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
BROWSER_DOWNLOADS_DIR=./data/downloads

# ------------------------------------------------------------------------------
# 6. Safety & Human Confirmation Boundaries
# ------------------------------------------------------------------------------
HUMAN_CONFIRMATION_REQUIRED=true
RATE_LIMIT_PER_MINUTE=60

# ------------------------------------------------------------------------------
# 7. MCP (Model Context Protocol) Server
# ------------------------------------------------------------------------------
MCP_SERVER_NAME=job-copilot

# ------------------------------------------------------------------------------
# 8. LLM Integration Placeholders (Optional / Advisory only)
# ------------------------------------------------------------------------------
LLM_PROVIDER=anthropic               # anthropic, openai, ollama, local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 9. Artifact & Object Storage Configuration (Phase 10A / Phase 12.2)
# ------------------------------------------------------------------------------
# Provider: 'local' (development/testing) or 's3' (production Cloudflare R2, AWS S3, MinIO, Wasabi)
ARTIFACT_STORAGE_PROVIDER=local       # local, s3
ARTIFACT_STORAGE_DIR=./data/artifacts
# S3 / Cloudflare R2 Bucket and Region (Aliases: S3_BUCKET, S3_REGION)
ARTIFACT_STORAGE_BUCKET=              # or S3_BUCKET (e.g. job-copilot-artifacts)
ARTIFACT_STORAGE_REGION=us-east-1     # or S3_REGION (e.g. auto for R2, us-east-1 for AWS)
# S3 / R2 Endpoint URL (Leave empty for standard AWS S3, set for Cloudflare R2 / MinIO)
ARTIFACT_STORAGE_ENDPOINT=            # or S3_ENDPOINT_URL (e.g. https://<account_id>.r2.cloudflarestorage.com)
# S3 Access Credentials (Aliases: S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY)
ARTIFACT_STORAGE_ACCESS_KEY=          # or S3_ACCESS_KEY_ID
ARTIFACT_STORAGE_SECRET_KEY=          # or S3_SECRET_ACCESS_KEY
ARTIFACT_MAX_SIZE_BYTES=52428800      # 50 MB limit per artifact

