# ==============================================================================
# Job Copilot - Environment Configuration Template
# NOTE: Copy this file to .env and configure for local runtime. Do NOT commit .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Runtime Settings
# ------------------------------------------------------------------------------
APP_ENV=development                  # development, staging, production
DEBUG=false
LOG_LEVEL=INFO                       # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=text                      # text, json

# ------------------------------------------------------------------------------
# 2. API Server Configuration
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# ------------------------------------------------------------------------------
# 3. Database & Storage Configuration
# ------------------------------------------------------------------------------
# Default: SQLite file inside data/ directory (or external PostgreSQL for cloud)
DATABASE_URL=sqlite:///./data/job_copilot.db
# PostgreSQL Example: postgresql://user:password@localhost:5432/job_copilot

# ------------------------------------------------------------------------------
# 4. Candidate Profile & Data Locations
# ------------------------------------------------------------------------------
CANDIDATE_PROFILE_PATH=./data/candidate/master_profile.yaml
CANDIDATE_EVIDENCE_PATH=./data/candidate/evidence.yaml
CANDIDATE_PREFERENCES_PATH=./data/candidate/preferences.yaml

# ------------------------------------------------------------------------------
# 5. Browser Automation & Playwright Settings
# ------------------------------------------------------------------------------
PLAYWRIGHT_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
BROWSER_DOWNLOADS_DIR=./data/downloads

# ------------------------------------------------------------------------------
# 6. Safety & Human Confirmation Boundaries
# ------------------------------------------------------------------------------
HUMAN_CONFIRMATION_REQUIRED=true
RATE_LIMIT_PER_MINUTE=60

# ------------------------------------------------------------------------------
# 7. MCP (Model Context Protocol) Server
# ------------------------------------------------------------------------------
MCP_SERVER_NAME=job-copilot

# ------------------------------------------------------------------------------
# 8. LLM Integration Placeholders (Optional / Advisory only)
# ------------------------------------------------------------------------------
LLM_PROVIDER=anthropic               # anthropic, openai, ollama, local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 9. Cloud Storage / Object Store Placeholders (Optional)
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local                # local, s3, gcs
S3_BUCKET_NAME=
AWS_REGION=us-east-1
