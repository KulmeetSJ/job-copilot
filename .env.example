# Copy to .env for local Docker Compose use. Replace every placeholder before starting.
APP_ENV=production
LOG_LEVEL=INFO
PORT=8000
API_PORT=8000
# Use a long random value; do not commit .env.
DASHBOARD_API_KEY=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-unique-database-password
DATABASE_URL=postgresql+psycopg://copilot_user:replace-with-a-unique-database-password@postgres:5432/job_copilot
CANDIDATE_DATA_DIR=./data/candidate
CANDIDATE_PROFILE_PATH=./data/candidate/master_profile.yaml
